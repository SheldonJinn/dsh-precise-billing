{
  "name": "dsh-precise-billing",
  "version": "0.2.4",
  "type": "module",
  "description": "按 DeepSeek 官方人民币价目（峰谷时段、节假日）逐请求精确计费，并提供费用条、侧栏卡片、用量看板与三段式热重启已开源：GitHub SheldonJinn/dsh-precise-billing，npm 包 dsh-precise-billing。",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "client.js",
    "package.json",
    "cordis.patch.yml",
    "README.md",
    "locale/*.json",
    "CREDITS.md",
    "docs",
    "LICENSE",
    "PUBLISHING.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "credits": [
    {
      "name": "DeepSeek-Usage",
      "license": "MIT",
      "repository": "https://github.com/sdiwenchen-lang/DeepSeek-Usage",
      "note": "用量看板、日历、趋势面板的设计参考；独立实现，未复制源码"
    },
    {
      "name": "dsh-hot-restart",
      "license": "MIT",
      "repository": "https://github.com/xiaolu511/dsh-hot-restart",
      "note": "热重启助手派发机制的思路参考；独立实现的精简版"
    },
    {
      "name": "dsh-unified-market",
      "license": "MIT",
      "repository": "https://github.com/jing-hy/dsh-unified-market",
      "note": "仅做过兼容性调研，本插件未使用其代码"
    },
    {
      "name": "dsh-duet",
      "license": "Apache-2.0",
      "repository": "https://github.com/YuMS/dsh-duet",
      "note": "仅做过语音交互调研，本插件未使用其代码"
    },
    {
      "name": "dsh-meter",
      "license": "MIT",
      "repository": "https://github.com/J-Chien/dsh-meter",
      "note": "会话计费、Token 分桶、缓存命中率与价格表设置页的计费思路参考；独立实现"
    }
  ],
  "author": "Sheldon Jinn",
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "billing",
    "usage",
    "token",
    "cost",
    "restart"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SheldonJinn/dsh-precise-billing.git"
  },
  "homepage": "https://github.com/SheldonJinn/dsh-precise-billing#readme",
  "bugs": {
    "url": "https://github.com/SheldonJinn/dsh-precise-billing/issues"
  }
}
